# Laspoh Proof — environment
# Copy to .env for local development. No real values belong in this file or in git.

# ── Model route ────────────────────────────────────────────────────────────────
# TWO ROUTES, and the service tells you which one it took at boot and on /health.
#
# Route A — Gemini API. Simplest for local work; no cloud credentials needed.
#   Set this and it wins.
# GEMINI_API_KEY=

# Route B — Vertex AI. What the deployed service uses. No key is involved: the
#   Cloud Run service authenticates as its own service account.
#   Locally this needs `gcloud auth application-default login`.
VERTEX_PROJECT=laspoh-proof-251233

# Vertex model availability is PER-REGION and per-project. Probed, not assumed:
# us-central1, us-east4 and europe-west4 all return 404 for this model in this
# project; asia-southeast1 serves it. See mission/ARCHITECTURE_DECISIONS.md AD-004.
VERTEX_LOCATION=asia-southeast1

# Must be Gemini 3.5 or newer for the hackathon's technology requirement.
GEMINI_MODEL=gemini-3.5-flash

# ── Service ────────────────────────────────────────────────────────────────────
# Cloud Run injects PORT; this is the local fallback.
PORT=8080

# Set to 1 to watch the browser drive itself locally. Headless otherwise.
# HEADFUL=1
